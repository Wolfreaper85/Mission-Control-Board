{
    "name": "mission-control",
    "version": "1.1.0",
    "description": "Visual Mission Control dashboard \u2014 monitor agents, manage goals, self-reflection engine with learned rules, bulletin board, and capsules.",
    "author": "Wolfreaper85",
    "icon": "\ud83c\udfaf",
    "priority": 40,
    "capabilities": {
        "tools": ["tools/mission.py"],
        "web": true,
        "hooks": {
            "pre_chat": "hooks/pre_chat.py",
            "pre_execute": "hooks/pre_execute.py",
            "post_chat": "hooks/post_chat.py",
            "post_execute": "hooks/post_execute.py",
            "prompt_inject": "hooks/prompt_inject.py"
        },
        "schedule": [
            {
                "name": "MC Daily Pattern Scan",
                "cron": "0 3 * * *",
                "handler": "schedule/pattern_scan.py",
                "description": "Daily scan for correction patterns, VFM scoring, and bulletin board rule proposals",
                "enabled": true
            },
            {
                "name": "MC Health Digest",
                "cron": "0 22 * * *",
                "handler": "schedule/health_digest.py",
                "description": "Daily system health summary posted to Discord — goals, memories, self-reflection activity",
                "enabled": true
            }
        ],
        "settings": [
            {
                "key": "show_apps_nav",
                "type": "boolean",
                "label": "Apps Launcher Nav Button",
                "default": false,
                "help": "Show the Apps launcher button in the navigation bar"
            },
            {
                "key": "correction_detection",
                "type": "boolean",
                "label": "Correction Detection",
                "default": true,
                "help": "Auto-detect when users correct the AI and log for pattern analysis"
            },
            {
                "key": "self_reflection",
                "type": "boolean",
                "label": "Self-Reflection",
                "default": true,
                "help": "Perform lightweight self-evaluation after complex tasks or corrections"
            },
            {
                "key": "learned_rules",
                "type": "boolean",
                "label": "Learned Rules",
                "default": true,
                "help": "Maintain and apply rules learned from corrections and manual injection"
            },
            {
                "key": "bulletin_board",
                "type": "boolean",
                "label": "Bulletin Board",
                "default": true,
                "help": "AI request board for standing orders, rule promotions, schedules, and capabilities"
            },
            {
                "key": "capsules",
                "type": "boolean",
                "label": "Reasoning Capsules",
                "default": true,
                "help": "Capture and reuse successful reasoning patterns from past tasks"
            },
            {
                "key": "write_ahead_logging",
                "type": "boolean",
                "label": "Write-Ahead Logging",
                "default": true,
                "help": "Save corrections immediately before AI responds (prevents data loss)"
            },
            {
                "key": "prompt_injection",
                "type": "boolean",
                "label": "Prompt Injection",
                "default": true,
                "help": "Inject active learned rules and capsules into the system prompt"
            },
            {
                "key": "workshop",
                "type": "boolean",
                "label": "Workshop",
                "default": true,
                "help": "Show the pixel art Workshop on the dashboard — disable to save GPU/CPU resources"
            },
            {
                "key": "daily_pattern_scan",
                "type": "boolean",
                "label": "Daily Pattern Scan",
                "default": true,
                "help": "Run daily analysis to detect recurring correction patterns and propose rule promotions"
            },
            {
                "key": "health_digest",
                "type": "boolean",
                "label": "Health Digest",
                "default": true,
                "help": "Post a daily system health summary to Discord — goals, memories, self-reflection activity"
            },
            {
                "key": "digest_channel",
                "type": "string",
                "label": "Digest Discord Channel",
                "default": "lexi-updates-for-wolf",
                "help": "Discord channel name for health digest posts"
            }
        ],
        "routes": [
            {
                "method": "GET",
                "path": "goals",
                "handler": "routes/dashboard.py:get_goals"
            },
            {
                "method": "POST",
                "path": "goals/update",
                "handler": "routes/dashboard.py:update_goal"
            },
            {
                "method": "POST",
                "path": "goals/create",
                "handler": "routes/dashboard.py:create_goal"
            },
            {
                "method": "POST",
                "path": "goals/delete",
                "handler": "routes/dashboard.py:delete_goal"
            },
            {
                "method": "GET",
                "path": "agents",
                "handler": "routes/dashboard.py:get_agents"
            },
            {
                "method": "GET",
                "path": "stats",
